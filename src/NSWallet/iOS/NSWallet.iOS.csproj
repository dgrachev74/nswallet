<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

    <!-- App Identity (Match your old bundle identifier) -->
    <ApplicationId>com.nswallet.app</ApplicationId>
    <ApplicationVersion>4.01</ApplicationVersion>
    <ApplicationDisplayVersion>4.01</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <ImageAsset Include="Resources\Images.xcassets\**" />
    <InterfaceDefinition Include="Resources\LaunchScreen.storyboard" />
    <BundleResource Include="Resources\**" Exclude="Resources\Images.xcassets\**;Resources\LaunchScreen.storyboard" />
  </ItemGroup>

</Project>
